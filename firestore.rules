rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdminFlagUnchanged() {
      return !('isAdmin' in request.resource.data)
        || request.resource.data.isAdmin == resource.data.get('isAdmin', false);
    }

    function userTextFieldsValid() {
      return (!('displayName' in request.resource.data)
          || (request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
              && request.resource.data.displayName.size() <= 48))
        && (!('bio' in request.resource.data)
          || (request.resource.data.bio is string
              && request.resource.data.bio.size() <= 160))
        && (!('username' in request.resource.data)
          || (request.resource.data.username is string
              && request.resource.data.username.size() >= 3
              && request.resource.data.username.size() <= 32))
        && (!('email' in request.resource.data)
          || (request.resource.data.email is string
              && request.resource.data.email.size() <= 256))
        && (!('language' in request.resource.data)
          || (request.resource.data.language is string
              && request.resource.data.language.size() <= 16));
    }

    function profileFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['displayName', 'bio', 'username', 'email', 'language']);
    }

    function friendKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['friendRequests']);
    }

    function friendKeysAndFriends() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['friendRequests', 'friends']);
    }

    // Another signed-in user adds themselves to this user's received list.
    function incomingFriendRequest(userId) {
      return signedIn()
        && request.auth.uid != userId
        && friendKeysOnly()
        && request.auth.uid in request.resource.data.get('friendRequests', {}).get('received', [])
        && !(request.auth.uid in resource.data.get('friendRequests', {}).get('received', []));
    }

    function activityFeedKeysValid() {
      return request.resource.data.keys().hasAll([
        'type', 'text', 'fromUid', 'fromName', 'timestamp'
      ])
        && (
          request.resource.data.keys().hasOnly([
            'type', 'text', 'fromUid', 'fromName', 'timestamp'
          ])
          || (
            request.resource.data.keys().hasOnly([
              'type', 'text', 'fromUid', 'fromName', 'timestamp', 'link'
            ])
            && request.resource.data.link is string
            && request.resource.data.link.size() <= 200
            && request.resource.data.link.matches('^/[a-zA-Z0-9_./?=&%-]{0,199}$')
          )
        );
    }

    // Accepter adds themselves to the requester's friends list (must have been in sent).
    function peerAcceptFriend(userId) {
      return signedIn()
        && request.auth.uid != userId
        && friendKeysAndFriends()
        && request.auth.uid in request.resource.data.get('friends', [])
        && !(request.auth.uid in resource.data.get('friends', []))
        && request.auth.uid in resource.data.get('friendRequests', {}).get('sent', []);
    }

    function isNotBanned() {
      return resource.data.get('banned', false) != true;
    }

    // Profile writes must read ban status from users/{uid}, not profiles (resource is null on create).
    function userIsNotBanned(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      return !userDoc.exists || userDoc.data.get('banned', false) != true;
    }

    function ownerProfileUpdate(userId) {
      return isOwner(userId)
        && isNotBanned()
        && isAdminFlagUnchanged()
        && (!profileFieldsChanged() || userTextFieldsValid());
    }

    function entitlementsUnchanged() {
      return !('entitlements' in request.resource.data)
        || request.resource.data.entitlements == resource.data.get('entitlements', {
          'detailedTest': false, 'testEstimator': false, 'animusPlus': false, 'animusPlusUntil': null
        });
    }

    function retentionKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'compareUsage', 'xp', 'lastXpReason', 'lastXpAt', 'lastDailyInsight',
          'dailyStreak', 'dailyMood', 'dailyReflection', 'moodHistory', 'reflectionHistory',
          'dailyArchive', 'streakUnlocks'
        ]);
    }

    function prefsUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prefs']);
    }

    function userPrefsValid() {
      return request.resource.data.prefs is map
        && request.resource.data.prefs.keys().hasOnly(['testProgressBar'])
        && request.resource.data.prefs.testProgressBar is bool;
    }

    function ownerPrefsUpdate(userId) {
      return isOwner(userId) && isNotBanned() && entitlementsUnchanged() && prefsUpdateOnly() && userPrefsValid();
    }

    function compareUsageIncrementValid() {
      return resource.data.get('entitlements', {}).get('animusPlus', false) == true
        || (
          request.resource.data.get('compareUsage', {}).count is int
          && request.resource.data.get('compareUsage', {}).count >= 0
          && request.resource.data.get('compareUsage', {}).count <= 10
        );
    }

    function ownerRetentionUpdate(userId) {
      return isOwner(userId)
        && isNotBanned()
        && retentionKeysOnly()
        && compareUsageIncrementValid();
    }

    function ownerProfileUpdateSafe(userId) {
      return ownerProfileUpdate(userId) && entitlementsUnchanged();
    }

    function adminUserUpdate(userId) {
      return isAdmin();
    }

    function estimationRecordValid() {
      return request.resource.data.subjectName is string
        && request.resource.data.subjectName.size() > 0
        && request.resource.data.subjectName.size() <= 64
        && (!('status' in request.resource.data)
          || (request.resource.data.status is string
            && request.resource.data.status in ['draft', 'complete']));
    }

    match /users/{userId}/estimations/{estId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && estimationRecordValid();
      allow update: if isOwner(userId) && estimationRecordValid();
      allow delete: if isOwner(userId);
    }

    function testDraftModeValid(modeId) {
      return modeId in ['short', 'full', 'estimator'];
    }

    function testDraftValid() {
      return request.resource.data.keys().hasAll([
          'testMode', 'cur', 'total', 'answers', 'savedAt'
        ])
        && request.resource.data.testMode is string
        && request.resource.data.testMode.size() <= 16
        && request.resource.data.cur is int
        && request.resource.data.cur >= 0
        && request.resource.data.cur <= 319
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 320
        && request.resource.data.cur < request.resource.data.total
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == request.resource.data.total
        && request.resource.data.savedAt is int
        && request.resource.data.savedAt > 0
        && (!('choiceIx' in request.resource.data)
          || (request.resource.data.choiceIx is list
            && request.resource.data.choiceIx.size() == request.resource.data.total))
        && (!('activeKeys' in request.resource.data)
          || (request.resource.data.activeKeys is list
            && request.resource.data.activeKeys.size() > 0
            && request.resource.data.activeKeys.size() <= 320))
        && (!('observerMode' in request.resource.data)
          || request.resource.data.observerMode is bool)
        && (!('observerSubjectName' in request.resource.data)
          || (request.resource.data.observerSubjectName is string
            && request.resource.data.observerSubjectName.size() <= 64));
    }

    match /users/{userId}/testDrafts/{modeId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && testDraftModeValid(modeId) && testDraftValid();
      allow delete: if isOwner(userId);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && userTextFieldsValid()
        && request.resource.data.get('banned', false) != true
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      allow update: if signedIn()
        && (
          ownerProfileUpdateSafe(userId)
          || ownerRetentionUpdate(userId)
          || ownerPrefsUpdate(userId)
          || incomingFriendRequest(userId)
          || peerAcceptFriend(userId)
          || adminUserUpdate(userId)
        );
      allow delete: if isOwner(userId);
    }

    function ownsUsernameDoc() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function usernameDocValid() {
      return request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.uid.size() <= 128;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && usernameDocValid()
        && (
          request.resource.data.uid == request.auth.uid
          || isAdmin()
        );
      allow update: if usernameDocValid()
        && (
          (ownsUsernameDoc() && request.resource.data.uid == request.auth.uid)
          || isAdmin()
        );
      allow delete: if ownsUsernameDoc() || isAdmin();
    }

    function profileWriteKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['latest', 'history', 'updatedAt', 'adminEditedAt']);
    }

    function profileCreateValid() {
      return request.resource.data.keys().hasAll(['latest']);
    }

    function profileNoPrivilegeEscalation() {
      return !('isAdmin' in request.resource.data)
        && !('entitlements' in request.resource.data)
        && !('banned' in request.resource.data);
    }

    function ownerProfileWrite(userId) {
      return isOwner(userId)
        && userIsNotBanned(userId)
        && profileNoPrivilegeEscalation()
        && (!('adminEditedAt' in request.resource.data)
          || request.resource.data.adminEditedAt == resource.data.get('adminEditedAt', null))
        && profileWriteKeysOnly();
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create: if (isOwner(userId) && userIsNotBanned(userId) && profileCreateValid() && profileNoPrivilegeEscalation())
        || isAdmin();
      allow update: if isAdmin() || ownerProfileWrite(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    function testSessionRecordValid() {
      return request.resource.data.keys().hasAll(['completedAt', 'testMode', 'items', 'resultSummary'])
        && request.resource.data.completedAt is string
        && request.resource.data.completedAt.size() <= 40
        && request.resource.data.testMode is string
        && request.resource.data.testMode.size() <= 16
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 320
        && request.resource.data.resultSummary is map;
    }

    match /testSessions/{userId}/records/{recordId} {
      allow read: if isAdmin();
      allow create: if isOwner(userId) && testSessionRecordValid();
      allow update, delete: if isAdmin();
    }

    // Stripe idempotency — server (service account) only.
    match /stripe_processed/{docId} {
      allow read, write: if false;
    }

    // Legacy collection — unused by app; deny all client access.
    match /notifications/{notifId} {
      allow read, write: if false;
    }

    match /activity/{userId} {
      match /feed/{feedId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && activityFeedKeysValid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 48;
        allow update, delete: if false;
      }
    }
  }
}
