rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdminFlagUnchanged() {
      return !('isAdmin' in request.resource.data)
        || request.resource.data.isAdmin == resource.data.get('isAdmin', false);
    }

    function userTextFieldsValid() {
      return (!('displayName' in request.resource.data)
          || (request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
              && request.resource.data.displayName.size() <= 48))
        && (!('bio' in request.resource.data)
          || (request.resource.data.bio is string
              && request.resource.data.bio.size() <= 160))
        && (!('username' in request.resource.data)
          || (request.resource.data.username is string
              && request.resource.data.username.size() >= 3
              && request.resource.data.username.size() <= 32))
        && (!('email' in request.resource.data)
          || (request.resource.data.email is string
              && request.resource.data.email.size() <= 256))
        && (!('language' in request.resource.data)
          || (request.resource.data.language is string
              && request.resource.data.language.size() <= 16));
    }

    function friendKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['friendRequests']);
    }

    function friendKeysAndFriends() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['friendRequests', 'friends']);
    }

    function incomingFriendRequest() {
      return signedIn()
        && request.auth.uid != userId
        && friendKeysOnly()
        && (request.auth.uid in request.resource.data.friendRequests.received)
        && !(request.auth.uid in resource.data.get('friendRequests', {}).get('received', []));
    }

    function peerAcceptFriend() {
      return signedIn()
        && request.auth.uid != userId
        && friendKeysAndFriends()
        && (request.auth.uid in request.resource.data.get('friends', []))
        && (request.auth.uid in resource.data.get('friendRequests', {}).get('sent', []))
        && !(request.auth.uid in request.resource.data.get('friendRequests', {}).get('sent', []));
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && userTextFieldsValid()
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      allow update: if signedIn()
        && userTextFieldsValid()
        && (
          (isOwner(userId) && isAdminFlagUnchanged())
          || incomingFriendRequest()
          || peerAcceptFriend()
        );
      allow delete: if isOwner(userId);
    }

    function ownsUsernameDoc() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow update: if ownsUsernameDoc()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if ownsUsernameDoc();
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Legacy collection — unused by app; deny all client access.
    match /notifications/{notifId} {
      allow read, write: if false;
    }

    match /activity/{userId} {
      match /feed/{feedId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'type', 'text', 'fromUid', 'fromName', 'timestamp', 'link'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 48
          && (!('link' in request.resource.data)
            || (request.resource.data.link is string
                && request.resource.data.link.size() <= 200
                && request.resource.data.link.matches('^/[a-zA-Z0-9_./?=&%-]{0,199}$')));
        allow update, delete: if false;
      }
    }
  }
}
